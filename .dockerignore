# Keep secrets, tooling and everything the running app does not read out of any container build.
.env
.env.*
.git
.gitignore
.venv
venv
__pycache__
*.pyc
.pytest_cache
.coverage*
.DS_Store
tests
docs
scripts
tools
CLAUDE.md
README.md
requirements-dev.txt
# demo/ is excluded except the three sample document sets: "Use sample documents" reads them at runtime (app/intake.py SAMPLE_DIR)
demo/*
!demo/samples
demo/samples/expected_extraction.json
demo/samples/expected_outcomes.json
