# ---- how the backend runs
RETRIEVER=local            # local = BM25 over data/policy_clauses.jsonl | azure = Azure AI Search
AGENT_MODE=offline         # offline = rule-based stand-in | foundry = your Foundry agent
DEFAULT_UIN=HDFHLIP25041V062425

# ---- Azure AI Search (claims-search-37)
AZURE_SEARCH_ENDPOINT=https://claims-search-37.search.windows.net
AZURE_SEARCH_KEY=<admin key from Keys blade>
AZURE_SEARCH_INDEX=claims-kb-v2

# ---- Azure OpenAI endpoint: the OpenAI tab of Keys and Endpoint on the resource that holds your deployments; used only for embeddings here
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<key>
EMBEDDING_DEPLOYMENT=text-embedding-3-large   # the deployment NAME in the Foundry resource
EMBEDDING_DIMENSIONS=1536                      # keep 1536 unless you also change the index

# ---- Foundry project (copy from the project overview page)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project-name>
MODEL_DEPLOYMENT=gpt-5-mini
AGENT_NAME=claims-adjudication-agent-v2

# ---- Timeouts, retries, limits (defaults shown; all optional)
TURN_DEADLINE_S=60        # a chat turn answers, or says "please try again", within this many seconds
MODEL_TIMEOUT_S=40        # one model call; never longer than what is left of the turn deadline
SEARCH_TIMEOUT_S=10
EMBED_TIMEOUT_S=10
MAX_RETRIES=3             # after the first try; only 429 and transient 5xx/connection errors are retried, with exponential backoff
BACKOFF_BASE_S=0.5
BACKOFF_CAP_S=8
MAX_REQUEST_BYTES=262144  # API request body limit (413 above this)
CORS_ORIGINS=             # comma-separated, e.g. http://localhost:5173 ; empty = no cross-origin access
LOG_LEVEL=INFO
